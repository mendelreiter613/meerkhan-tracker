# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Google AI (Gemini) API key for the AI Assistant chat feature
GOOGLE_GENERATIVE_AI_API_KEY=

# Public site URL, used for auth redirect callbacks
NEXT_PUBLIC_SITE_URL=

# Optional: per-user daily AI spend cap in USD (defaults to 1 if unset)
AI_DAILY_COST_CAP_USD=1
